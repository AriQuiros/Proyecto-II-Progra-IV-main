INSERT INTO HORARIO (doctor_id, dia, horainicio, horafin)
SELECT id, ((id - 2) MOD 7) + 1, 8, 12 FROM MEDICO
UNION ALL
SELECT id, ((id - 1) MOD 7) + 1, 13, 17 FROM MEDICO
UNION ALL
SELECT id, (id MOD 7) + 1, 18, 21 FROM MEDICO;

INSERT INTO CITA (doctor_id, paciente_id, fecha_hora, estado, notas)
SELECT
    m.id AS doctor_id,
    202 + MOD(((m.id - 2) * 10) + s.n, 200) AS paciente_id,
    DATE_ADD(
        DATE_ADD(
            '2026-03-02 00:00:00',
            INTERVAL (
                FLOOR(s.n / 3) * 7 +
                CASE
                    WHEN MOD(s.n, 3) = 0 THEN (((m.id - 2) MOD 7) + 1) - 1
                    WHEN MOD(s.n, 3) = 1 THEN (((m.id - 1) MOD 7) + 1) - 1
                    ELSE ((m.id MOD 7) + 1) - 1
                END
            ) DAY
        ),
        INTERVAL CASE
            WHEN MOD(s.n, 3) = 0 THEN 8
            WHEN MOD(s.n, 3) = 1 THEN 13
            ELSE 18
        END HOUR
    ) AS fecha_hora,
    CASE
        WHEN MOD(s.n, 5) IN (0, 3) THEN 'CONFIRMADA'
        WHEN MOD(s.n, 5) IN (1, 4) THEN 'PENDIENTE'
        ELSE 'CANCELADA'
    END AS estado,
    CONCAT('Cita ', s.n + 1, ' de 10 para medico ', m.id) AS notas
FROM MEDICO m
CROSS JOIN (
    SELECT 0 AS n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4
    UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9
) s
ORDER BY m.id, s.n;
